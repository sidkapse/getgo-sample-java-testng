<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GetGo API Test Suite" verbose="1" parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Booking API Tests">
        <classes>
            <class name="com.getgo.api.tests.BookingApiTest"/>
        </classes>
    </test>

    <test name="Driver API Tests">
        <classes>
            <class name="com.getgo.api.tests.DriverApiTest"/>
        </classes>
    </test>

    <test name="Ride API Tests">
        <classes>
            <class name="com.getgo.api.tests.RideApiTest"/>
        </classes>
    </test>

</suite>
